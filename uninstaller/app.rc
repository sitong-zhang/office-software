#include <windows.h>

1 ICON "uninstaller/icon.ico"
110 RCDATA "app/branding/logo.png"
111 RCDATA "app/branding/logo-cream.png"

#include "../app/ui/icons.rc"

1 24 "uninstaller/app.manifest"

1 VERSIONINFO
FILEVERSION 0,4,3,0
PRODUCTVERSION 0,4,2,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
